ENV=development
# Origin used in QR links. Leave empty to use the address the instructor opened
# (works with the cloudflared tunnel without editing this file).
PUBLIC_URL=
# Required when ENV=production (32+ chars). Empty in development: a random key is generated.
SECRET_KEY=
POSTGRES_PASSWORD=attendify
# real: dlib face service. mock: deterministic hash-based embeddings, for tests only.
FACE_MODE=real
FACE_MATCH_MAX_DISTANCE=0.45
QR_ROTATE_SECONDS=15
SEED_DEMO_DATA=true
# optional: without SMTP, password reset codes are printed in `docker compose logs api`
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
